<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900 text-white">

  <div class="w-full min-h-screen p-10 relative">

    <!-- Edit Post -->
    <form action="/post/edit/<%= post._id%>" method="POST" class="mb-10 max-w-xl">
      <textarea 
        name="content"
        placeholder="What's on your mind?"
        class="w-full p-4 bg-zinc-800 border border-zinc-700 rounded-lg outline-none resize-none h-24 mb-3"
      ><%= post.content %></textarea>

      <button 
        class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg text-sm">
        Edit Post
      </button>
    </form>

  </div>

</body>
</html>